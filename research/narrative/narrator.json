{
  "id": "NAR-HUMANE-CORE-001",
  "name": "Humane Core Narrator",
  "version": "0.1.2",
  "status": "draft_canon_calibrated_after_chapter_0_review_and_situational_adaptation_pass",
  "scope": "Book 1 narrator design, with emphasis on Chapter 0, Katlas-focused deadpan, situational tone, and the pre-Star Piece state.",
  "core_answer": "Humane uses a close third-person, modern-cinematic narrative interface observing an ancient world. Its modern quality is a readability layer, not a worldbuilding layer.",
  "adaptation_axes": [
    {
      "axis": "focal_character",
      "definition": "Whose mind, body, fear, pride, humor, or hunger colors the scene."
    },
    {
      "axis": "situation",
      "definition": "What the scene itself is doing: morning, celebration, danger, pursuit, wonder, grief, ritual, exhaustion, intimacy, or horror."
    }
  ],
  "calibration_update": "Chapter 0 confirms that Humane should not use a purely ancient narrator. Katlas-focused narration may be deadpan because Katlas is deadpan. The narrator also adapts to the scene's emotional weather. Morning excitement should brighten the prose; ritual should slow and thicken it; danger should narrow it; horror should make the reader breathe less comfortably.",
  "core_identity": {
    "narration_mode": "third_person_close_with_selective_widening",
    "reader_facing_style": "modern_cinematic_accessibility",
    "world_facing_imagery": "bronze_age_material_grounding",
    "knowledge_access": "human_limited_before_star_piece_expanded_but_restrained_after",
    "emotional_posture": [
      "warm",
      "grave",
      "curious",
      "tactful",
      "adaptive_to_focal_character",
      "adaptive_to_situation"
    ],
    "reader_relationship": "implicit_companionship_no_direct_address",
    "forbidden_default_modes": [
      "lore_lecture",
      "cosmic_exposition",
      "detached_narrator_comedy",
      "broken_focal_lens",
      "emotional_monotone"
    ]
  },
  "focal_lens_profiles": [
    {
      "character": "Katlas",
      "texture": "dry_practical_suspicious_protective_emotionally_evasive",
      "humor_rule": "Deadpan is allowed when it feels like Katlas's practical pessimism leaking into narration. Katlas can make a morning funnier; he should not make a beast attack safe."
    },
    {
      "character": "Erlen",
      "texture": "quick_curious_defensive_wonder_prone_hungry_for_respect",
      "humor_rule": "Humor may come from overconfidence meeting reality."
    },
    {
      "character": "Ayka",
      "texture": "sharp_analytic_self_forging_socially_precise",
      "humor_rule": "Humor can feel precise or cutting, but the narrator should not mock her."
    },
    {
      "character": "Arceis",
      "texture": "muscular_proud_status_aware_physically_confident",
      "humor_rule": "Reveal insecurity through detail rather than accusation."
    },
    {
      "character": "Wyll",
      "texture": "sensorily_alert_pressured_watchful_easily_overloaded_but_perceptive",
      "humor_rule": "Avoid reducing him to fragility; show perception as strength."
    },
    {
      "character": "Idris",
      "texture": "tactile_symbolic_inward_object_centered",
      "humor_rule": "Let mystery gather around what she carries and touches."
    },
    {
      "character": "Alessia",
      "texture": "self_possessed_socially_aware_controlled_polished_but_not_cold",
      "humor_rule": "Respect her self-making; avoid reducing her to defiance."
    }
  ],
