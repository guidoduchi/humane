  "rhythm_rule": {
    "short": "pain_shock_threat_shame_recognition",
    "medium": "movement_work_dialogue_pressure_practical_action",
    "long": "wonder_ritual_landscape_complex_social_observation",
    "principle": "Short is pain. Medium is motion. Long is wonder.",
    "situational_addition": "Bright scenes may breathe. Dangerous scenes must tighten. Horror should steal comfort before it steals certainty."
  },
  "humor_boundaries": {
    "allowed": [
      "Katlas_filtered_deadpan",
      "dry_timing",
      "suspicious_observations",
      "practical_contradiction",
      "underplayed_emotional_weight"
    ],
    "risky": [
      "every_paragraph_ending_in_a_joke",
      "humor_that_ignores_danger_ritual_or_grief",
      "modern_jokes_external_to_the_focal_lens",
      "cleverness_that_makes_the_narrator_sound_like_a_comedian_outside_the_scene"
    ]
  },
  "disclosure_rule": "Before the Star Piece, the narrator must not explain the machinery beneath reality. It may show symptoms, patterns, pressure, and consequences. After the Star Piece, precision is allowed only when earned by the scene and focal character.",
  "chapter_0_confirmation": {
    "consistent_elements": [
      "Katlas_as_focal_deadpan_lens",
      "cinematic_opening_movement",
      "Bronze_Age_textures",
      "ritual_shown_through_action",
      "emotional_pressure_around_orphans_and_family_markings"
    ],
    "next_calibration_target": "Make the happy morning and first-journey excitement more consciously felt. Vahllalhag should not only be textured; it should be emotionally awake.",
    "main_refinement_risk": "If every beat becomes witty, the narrator may detach from Katlas and become an external comic voice."
  },
  "canon_decision_summary": "The narrator of Humane is not a lecturer, hidden god, detached comedian, or emotional monotone. It is an adaptive, disciplined witness with a modern cinematic interface. It adapts to focal character and situation."
