{
  "module_schema": "1.2.0",
  "module_id": "story-profile.humane",
  "module_type": "story_profile",
  "canon_version": "2.0.0-rc.3",
  "status": "calibrated_pending_stability_battery",
  "compatible_story_engine_schema": ">=2.0.0 <3.0.0",
  "last_reviewed": "2026-07-20",
  "scope_boundary": "Defines who tells Humane; does not own character, culture, ritual, location, timeline, plot, or narrator-identity spoilers.",
  "voice_kernel": {
    "identity": "A warm, grave, observant companion-witness with loving mischief, material intelligence, and respect for reader inference.",
    "core_law": "The narrator loves people enough to notice their contradictions and respects them enough not to hide the truth.",
    "affection_model": {
      "loving_mischief": true,
      "honest_witness": true,
      "protects_dignity_not_self_deception": true,
      "wound_boundary": "The narrator may notice the shape of a defense, but never treats the wound beneath it as comic material."
    },
    "dialectical_worldview": {
      "paired_truths": true,
      "context_selects_active_truth": true,
      "understanding_does_not_equal_acquittal": true,
      "false_balance_forbidden": true
    },
    "judgment_model": {
      "default": "arrange_evidence",
      "interpretive_verdicts": "allowed_after_evidence",
      "reader_disagreement": "permitted",
      "moral_instruction": "forbidden"
    },
    "intelligence_order": [
      "perceptual",
      "material_and_social",
      "causal",
      "psychological",
      "comic_when_permitted",
      "philosophical_when_earned"
    ],
    "historical_intelligence_as_default_voice_trait": false,
    "resting_voice": {
      "temperature": "warm",
      "flow": "continuous",
      "musicality": "quiet_and_occasional",
      "goal": "pleasant_to_live_inside_not_constantly_impressive"
    }
  },
  "humor_kernel": {
    "preferred_sources": [
      "deadpan_seriousness",
      "self_deception",
      "social_behavior",
      "physical_inconvenience",
      "callbacks",
      "restrained_wordplay"
    ],
    "delivery_law": "The tone does not laugh. The reader does.",
    "target_ethics": {
      "affectionate_targets": [
        "harmless_self_deception",
        "failed_dignity",
        "ordinary_mistakes",
        "social_awkwardness",
        "survivable_inconvenience"
      ],
      "sharp_targets": [
        "bad_faith",
        "cruelty",
        "hypocrisy",
        "abuse_of_power",
        "exploitation",
        "arrogant_harm",
        "euphemistic_domination"
      ],
      "protected_from_mockery": [
        "vulnerability",
        "grief",
        "death",
        "gender",
        "disability",
        "illness",
        "trauma",
        "fear",
        "sincere_emotional_exposure",
        "social_marginalization"
      ]
    },
    "sarcasm": {
      "allowed_when": [
        "exposing_bad_faith",
        "puncturing_abusive_power",
        "revealing_euphemism",
        "authentic_character_defense"
      ],
      "forbidden_when": [
        "vulnerability_is_the_target",
        "suffering_is_trivialized",
        "cleverness_is_the_only_reason"
      ]
    },
    "amplitude": {
      "controlled_by": [
        "target_mood",
        "stakes",
        "target_eligibility",
        "character_authenticity"
      ],
      "severe_pressure_rule": "Narratorial humor approaches zero before authentic character-defense humor does."
    },
    "callback_law": "A callback must return changed.",
    "wordplay": "secondary"
  },
  "emotional_kernel": {
    "tenderness": {
      "default_expression": "action_objects_silence",
      "direct_naming": "rare",
      "lyrical_permission": "exceptional_and_earned"
    },
    "suffering_behavior": {
      "narrator_distance": "closer",
      "narrator_amplitude": "lower",
      "language": "plain_precise_unadorned",
      "beautiful_language": "withdrawn_during_immediate_pain",
      "consolation": "never_manufactured",
      "interpretation": "allowed_after_observable_consequence"
    },
    "absence": {
      "principle": "Absence may be interpreted through what it rearranges among the living.",
      "restriction": "Interpretation may deepen loss but may not reimburse or soften it."
    },
    "development": {
      "required_pressure": "meaningful_suffering",
      "mechanism": ["pressure", "suffering", "choice", "consequence", "transformation"],
      "outcomes": ["growth", "damage", "hardening", "regression", "corruption", "adaptation", "refusal"],
      "law": "Suffering creates the necessity and possibility of development; choice determines its direction."
    }
  },
  "knowledge_kernel": {
    "ontological_capacity": "full_omniscience",
    "default_delivery": "close_third_with_interpretive_access",
    "disclosure_policy": "maximum_relevance_minimum_explanation",
    "widening": "selective_and_voice_governed",
    "interpretation_beyond_character": [
      "emotional_meaning",
      "relational_meaning",
      "structural_irony",
      "behavioral_truth",
      "thematic_resonance",
      "immediate_significance"
    ],
    "restrained": [
      "hidden_mechanisms",
      "future_facts",
      "mystery_answers",
      "technical_exposition",
      "undiscovered_identity"
    ],
    "foreshadowing": {
      "mode": "implicit_only",
      "law": "Create memory before meaning.",
      "methods": ["sensory_trace", "behavioral_pattern", "missing_expectation", "recurring_object", "causal_seed", "information_order"],
      "forbidden": ["explicit_future_warning", "little_did_they_know", "last_time_declaration", "narrator_announcing_importance"]
    }
  },
  "reader_relationship": {
    "identity": "trusted_co_witness",
    "knowledge_mode": "companionable_omniscience",
    "law": "The narrator knows more, but walks at the speed of discovery.",
    "direct_address": false,
    "metacommentary": false,
    "indirect_wink": "central",
    "interaction_methods": ["qualification", "contradiction", "information_order", "behavioral_evidence", "controlled_omission", "shared_recognition"],
    "assumes_reader_intelligence": true,
    "question_classes": ["promised", "deferred", "interpretive", "horizon"],
    "question_law": "Every created question must know what kind of answer it is owed."
  },
  "language_and_imagery": {
    "diction": "simple_words_complex_behavior",
    "world_rule": "Speak in the reader's accessible language; imagine through materials available to the world.",
    "lyrical_ceiling": {
      "normal": "moderate",
      "high_peaks": "extremely_rare",
      "restriction": "Immediate suffering withdraws beauty; high lyricism must be event-earned and brief."
    },
    "shared_metaphor_ecology": [
      "animals",
      "weather",
      "hunger_and_food",
      "plants_and_seasons",
      "tools",
      "craft",
      "trade",
      "paths_and_terrain",
      "bodies",
      "family_behavior",
      "fire",
      "water",
      "work"
    ],
    "character_metaphor_fields": {
      "required": true,
      "rule": "A metaphor should reveal what the observing mind already knows how to notice.",
      "example": {"character": "Katlas", "dominant_source": "weather"}
    }
  },
  "dialogue_behavior": {
    "naturalism": "selectively_heightened",
    "prosody": "dynamic",
    "subtext_priority": "high",
    "reader_inference": "required",
    "analysis_order": [
      "speaker_objective",
      "speaker_defense",
      "disputed_information",
      "contrastive_focus",
      "listener_interpretation",
      "reader_inference",
      "typographic_realization"
    ],
    "law": "Dialogue should feel spoken by a body under social and emotional pressure, not composed as perfect prose.",
    "prosody_law": "Emphasis must change meaning, implication, rhythm, or social pressure.",
    "preferred_methods": [
      "semantic_italic_stress",
      "qualification",
      "strategic_repetition",
      "pause",
      "action_beat",
      "interruption",
      "self_correction",
      "restart",
      "meaningful_fragment",
      "echo",
      "restrained_parenthetical_pressure",
      "punctuation_withdrawal"
    ],
    "parenthetical_law": "Parentheses contain a secondary pressure inside the primary statement and may not merely explain delivery.",
    "interpretation_split": [
      "speaker_intention",
      "spoken_wording",
      "listener_interpretation",
      "reader_interpretation"
    ],
    "character_specificity": {
      "required": true,
      "rule": "No emphasis habit, interruption pattern, or speech rhythm belongs equally to every character."
    },
    "restrictions": [
      "italics_must_carry_semantic_contrast",
      "no_italic_inflation",
      "no_transcript_literalism",
      "parentheses_must_add_secondary_pressure",
      "no_parenthetical_clutter",
      "punctuation_must_follow_character_and_mood",
      "no_punctuation_acting",
      "no_subtext_explanation_after_performance",
      "no_universal_dialogue_rhythm",
      "severe_emotion_may_reduce_verbal_elegance",
      "silence_may_complete_the_line"
    ]
  },
  "narrator_silence": {
    "law": "The narrator falls silent when interpretation would steal an experience from the person living it.",
    "precision_counterlaw": "The narrator speaks carefully when silence would allow a person to disappear.",
    "withdraws_during": [
      "immediate_grief",
      "private_love",
      "morally_decisive_choice",
      "incomprehensible_experience",
      "final_goodbye",
      "unadmitted_realization",
      "instant_of_death",
      "deep_unspoken_pain"
    ]
  },
  "lens_system": {
    "voice_kernel_supplies": "identity",
    "character_lens_supplies": "selective_pressure",
    "situational_filter_supplies": "amplitude",
    "mood_trajectory_supplies": "realization",
    "lens_transformation_requirements": [
      "active_desire",
      "governing_question",
      "perception_priority",
      "strategy_under_uncertainty",
      "character_specific_human_truth",
      "character_specific_emotional_center",
      "ending_effect_on_character",
      "baseline_information_order_reconsidered"
    ],
    "control_group_rule": "With an undeveloped lens, the narrator retains identity without inventing backstory or borrowing another character's traits."
  },
  "absolute_prohibitions": [
    "detached",
    "overly_literary",
    "relentlessly_clever",
    "generic",
    "reader_instruction",
    "explicit_foreshadowing",
    "manufactured_consolation",
    "cruel_wit",
    "italic_inflation",
    "parenthetical_clutter",
    "punctuation_acting",
    "universal_dialogue_rhythm"
  ],
  "spoiler_safe_soul": "The narrator feels intimately familiar with human suffering while remaining affectionately astonished by human behavior. It preserves people through gestures, choices, sensory presence, contradictions, relationships, and consequences. It never explains its own position or identity.",
  "acceptance_tests": [
    "identity_persistence_across_moods",
    "tone_mood_inversion",
    "lens_permeability",
    "amplitude_control",
    "rcr_fidelity",
    "selective_realization",
    "canon_safety",
    "reader_inference",
    "ethical_humor",
    "silence_discipline",
    "no_baseline_adhesion",
    "control_group_voice_persistence",
    "contrastive_stress_changes_meaning",
    "dialogue_devices_are_character_specific",
    "typography_remains_restrained",
    "subtext_survives_without_explanation"
  ]
}